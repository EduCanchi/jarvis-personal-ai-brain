# Copia este archivo a .env.local solo si prefieres variables de entorno.
# La vía recomendada es guardar la clave desde la app: Configuración → Clave de NVIDIA
# (se almacena en el Llavero de macOS). Nunca subas .env.local a Git.

NVIDIA_API_KEY=nvapi-tu-clave-aqui

# Opcionales
# PAIB_DATA_DIR=/ruta/alternativa/de/datos
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
